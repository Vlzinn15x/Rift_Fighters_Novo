{
  "name": "rift-fighters",
  "version": "34.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node tests/guest-combat.cjs && node --experimental-strip-types tests/worker.mjs",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rift-fighters-rooms",
    "db:local": "wrangler d1 migrations apply rift-fighters-rooms --local",
    "db:remote": "wrangler d1 migrations apply rift-fighters-rooms --remote"
  },
  "devDependencies": {
    "wrangler": "4.92.0"
  }
}
